{
  "version": 1,
  "id": "checkout",
  "title": "Checkout",
  "description": "Pay for an order with UPI, card or netbanking. Each method shows only its own fields, and only visible fields are validated.",
  "state": {
    "step": "pay",
    "items": [
      { "label": "The Pragmatic Programmer", "amount": 2299 },
      { "label": "Delivery", "amount": 40 },
      { "label": "Coupon READ10", "amount": -230, "note": "10% off books" }
    ],
    "method": "upi",
    "upi": "",
    "card": { "number": "", "expiry": "", "cvv": "", "name": "" },
    "saveCard": false,
    "bank": ""
  },
  "body": [
    {
      "type": "Stack",
      "id": "pay",
      "when": "step == 'pay'",
      "props": { "gap": "lg" },
      "children": [
        { "type": "Merchant", "props": { "name": "Bluebird Books", "subtitle": "Order #BB-20419", "verified": true } },
        {
          "type": "Card",
          "props": { "title": "Order summary" },
          "children": [
            { "type": "OrderSummary", "props": { "title": "Items in this order", "items": "{{ items }}", "totalLabel": "To pay" } }
          ]
        },
        {
          "type": "Card",
          "props": { "title": "Pay with" },
          "children": [
            {
              "type": "Stack",
              "props": { "gap": "lg" },
              "children": [
                {
                  "type": "RadioCards",
                  "id": "method",
                  "bind": "method",
                  "props": {
                    "label": "Payment method",
                    "options": [
                      { "value": "upi", "label": "UPI", "description": "Google Pay, PhonePe, Paytm or any UPI app", "badge": "Fastest", "icon": "upi" },
                      { "value": "card", "label": "Credit or debit card", "description": "Visa, Mastercard, RuPay and Amex", "icon": "card" },
                      { "value": "netbanking", "label": "Netbanking", "description": "Pay from your bank account", "icon": "bank" }
                    ]
                  },
                  "rules": [{ "type": "required", "message": "Choose how you want to pay" }]
                },
                {
                  "type": "Stack",
                  "when": "method == 'upi'",
                  "children": [
                    {
                      "type": "TextField",
                      "id": "upi",
                      "bind": "upi",
                      "props": { "label": "UPI ID", "hint": "For example, name@okhdfcbank. Try fail@upi to see a declined payment.", "placeholder": "name@bank", "transform": "lower", "inputMode": "email" },
                      "rules": [{ "type": "required", "message": "Enter your UPI ID" }, { "type": "upi" }]
                    }
                  ]
                },
                {
                  "type": "Stack",
                  "when": "method == 'card'",
                  "children": [
                    {
                      "type": "CardNumberField",
                      "bind": "card.number",
                      "props": { "hint": "Test cards: 4111 1111 1111 1111 succeeds, 4000 0000 0000 0002 is declined." },
                      "rules": [{ "type": "required", "message": "Enter your card number" }, { "type": "luhn" }]
                    },
                    {
                      "type": "Stack",
                      "props": { "direction": "row", "gap": "md", "wrap": true },
                      "children": [
                        { "type": "ExpiryField", "bind": "card.expiry", "rules": [{ "type": "required", "message": "Enter the expiry date" }, { "type": "expiry" }] },
                        { "type": "CvvField", "bind": "card.cvv", "rules": [{ "type": "required", "message": "Enter the CVV" }, { "type": "cvv" }] }
                      ]
                    },
                    {
                      "type": "TextField",
                      "bind": "card.name",
                      "props": { "label": "Name on card", "autoComplete": "cc-name" },
                      "rules": [{ "type": "required", "message": "Enter the name on the card" }, { "type": "minLength", "value": 2 }]
                    },
                    { "type": "Checkbox", "bind": "saveCard", "props": { "label": "Save this card for faster checkout", "hint": "Saved as a secure token. We never store your CVV." } }
                  ]
                },
                {
                  "type": "Stack",
                  "when": "method == 'netbanking'",
                  "children": [
                    {
                      "type": "SelectField",
                      "bind": "bank",
                      "props": {
                        "label": "Bank",
                        "placeholder": "Choose your bank",
                        "options": [
                          { "value": "sbi", "label": "State Bank of India" },
                          { "value": "hdfc", "label": "HDFC Bank" },
                          { "value": "icici", "label": "ICICI Bank" },
                          { "value": "axis", "label": "Axis Bank" },
                          { "value": "kotak", "label": "Kotak Mahindra Bank" }
                        ]
                      },
                      "rules": [{ "type": "required", "message": "Choose your bank" }]
                    },
                    { "type": "Text", "props": { "text": "You will be sent to your bank's website to approve the payment.", "tone": "muted", "size": "sm" } }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "ErrorSummary" },
        {
          "type": "Alert",
          "when": "$form.status == 'error'",
          "props": { "tone": "danger", "title": "Payment not completed", "text": "{{ $form.error }}" }
        },
        {
          "type": "Button",
          "id": "pay-button",
          "props": { "label": "Pay {{ sum(items, 'amount') | inr }}", "loadingLabel": "Processing payment…", "fullWidth": true },
          "action": {
            "type": "submit",
            "endpoint": "payments/create",
            "payload": ["method", "upi", "card", "bank", "saveCard", "items"],
            "timeoutMs": 8000,
            "onSuccess": { "type": "set", "path": "step", "value": "done" }
          }
        },
        { "type": "Text", "props": { "text": "Payments are encrypted end to end. You will not be charged twice if you retry.", "tone": "muted", "size": "sm", "align": "center" } }
      ]
    },
    {
      "type": "Stack",
      "id": "done",
      "when": "step == 'done'",
      "props": { "gap": "lg" },
      "children": [
        {
          "type": "PaymentStatus",
          "props": {
            "status": "success",
            "title": "{{ sum(items, 'amount') | inr }} paid to Bluebird Books",
            "text": "Your order is confirmed. A receipt is on its way to your email.",
            "reference": "{{ $result.reference }}"
          }
        },
        {
          "type": "Card",
          "props": { "title": "Payment details", "tone": "subtle" },
          "children": [
            {
              "type": "KeyValue",
              "props": {
                "items": [
                  { "label": "Paid with", "value": "{{ method == 'upi' ? 'UPI · ' + upi : method == 'card' ? 'Card ending ' + last4(card.number) : 'Netbanking · ' + upper(bank) }}" },
                  { "label": "Amount", "value": "{{ sum(items, 'amount') | inr }}" },
                  { "label": "Reference", "value": "{{ $result.reference }}" }
                ]
              }
            }
          ]
        },
        { "type": "Button", "props": { "label": "Start a new order", "variant": "secondary", "fullWidth": true }, "action": { "type": "reset" } }
      ]
    }
  ]
}
